// Vector icon set (24×24 design grid, Material-flavored) — one dispatcher
// component, recolored per use.

import { Theme } from "../theme.slint";

export component Icon inherits Path {
    in property <string> icon;
    in property <color> icon-color: Theme.text-secondary;
    in property <length> icon-size: Theme.icon-size;

    width: icon-size;
    height: icon-size;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: icon-color;
    fill-rule: icon == "star-outline" || icon == "search" || icon == "find"
        || icon == "zoom-in" || icon == "zoom-out" || icon == "lock"
        || icon == "globe" || icon == "shield-outline" ? FillRule.evenodd
        : FillRule.nonzero;

    commands:         icon == "back" ? "M15.5 4.5 L7 12 L15.5 19.5 L17.2 17.8 L10.4 12 L17.2 6.2 Z" :
        icon == "forward" ? "M8.5 4.5 L17 12 L8.5 19.5 L6.8 17.8 L13.6 12 L6.8 6.2 Z" :
